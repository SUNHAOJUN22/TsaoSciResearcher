    "| ![尺度桥误差预算](assets/ai/multiscale_bridge_error_budget.svg) | 来源、映射、闭合与目标尺度不确定性 |\n"
    "| ![Schema 验证流水线](assets/ai/mathematical_contract_schema_pipeline.svg) | 规范 Schema、包内镜像、运行时校验与交付工件 |",
)

replace_once(
    "docs/index.md",
    "- 19 JSON Schemas;",
    "- 20 JSON Schemas, including a package-mirrored mathematical-contract registry schema;",
)

replace_once(
    "CHANGELOG.md",
    "## Unreleased\n\n## 0.7.4 - 2026-08-06\n",
    "## Unreleased\n\n"
    "## 0.7.5 - 2026-08-07\n\n"
    "- Add a closed Draft 2020-12 Schema for full and single mathematical-contract registry payloads.\n"
    "- Package a byte-identical schema mirror and validate every bilingual or localized math response before emission.\n"
    "- Add `math --schema`, deterministic `math --output`, an offline validator, a canonical example and adversarial boundary-forgery tests.\n"
    "- Extend the bilingual README and visual atlas to 20 Schemas and 38 repository-local conceptual SVG diagrams.\n"
    "- Preserve the fixed `advisory_only=true`, `solver_executed=false` and `automatic_approval=false` scientific boundary.\n\n"
    "## 0.7.4 - 2026-08-06\n",
)

ci_path = ".github/workflows/ci.yml"
ci = read(ci_path)
old_compat = '''          python -m tsao_researcher math --contract decision-readiness --language both
          python scripts/validate_schemas.py
          python scripts/validate_computation_strategy.py examples/first-principles-strategy.json
'''
new_compat = '''          python -m tsao_researcher math --schema
          python -m tsao_researcher math --contract decision-readiness --language both --output artifacts-math-contract.json
          python scripts/validate_mathematical_contracts.py --check
          python scripts/validate_schemas.py
          python scripts/validate_computation_strategy.py examples/first-principles-strategy.json
'''
if ci.count(old_compat) != 1:
    raise SystemExit("ci.yml compatibility mathematical anchor missing or ambiguous")
ci = ci.replace(old_compat, new_compat, 1)
old_full = '''          python scripts/validate_computation_strategy.py examples/first-principles-strategy.json
          python -m tsao_researcher math --contract uncertainty-budget --language en
          mkdocs build --strict
'''
new_full = '''          python scripts/validate_computation_strategy.py examples/first-principles-strategy.json
          python -m tsao_researcher math --schema
          python -m tsao_researcher math --contract uncertainty-budget --language en --output artifacts-math-contract.json
          python scripts/validate_mathematical_contracts.py --check
          mkdocs build --strict
'''
if ci.count(old_full) != 1:
    raise SystemExit("ci.yml full-validation mathematical anchor missing or ambiguous")
write(ci_path, ci.replace(old_full, new_full, 1))

subprocess.run([sys.executable, "scripts/bump_version.py", "0.7.5"], cwd=ROOT, check=True)
subprocess.run([sys.executable, "scripts/sync_runtime_data.py", "--write"], cwd=ROOT, check=True)
subprocess.run(
    [sys.executable, "scripts/validate_mathematical_contracts.py", "--write-example"],
    cwd=ROOT,
    check=True,
)
subprocess.run(
    [sys.executable, "-m", "ruff", "format", "scripts", "tsao_researcher", "tests"],
    cwd=ROOT,
    check=True,
)
subprocess.run([sys.executable, "scripts/build_readme_facts.py", "--write"], cwd=ROOT, check=True)
print("applied v0.7.5 schema-backed mathematical delivery payload")
