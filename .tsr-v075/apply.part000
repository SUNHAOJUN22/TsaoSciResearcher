#!/usr/bin/env python3
"Apply the one-time v0.7.5 schema-backed mathematical delivery payload."

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def read(relative: str) -> str:
    return (ROOT / relative).read_text(encoding="utf-8", errors="strict")


def write(relative: str, content: str) -> None:
    path = ROOT / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8", newline="\n")


def replace_once(relative: str, old: str, new: str) -> None:
    text = read(relative)
    count = text.count(old)
    if count != 1:
        raise SystemExit(f"{relative}: expected one replacement anchor, found {count}: {old[:80]!r}")
    write(relative, text.replace(old, new, 1))


SCHEMA_ID = (
    "https://sunhaojun22.github.io/TsaoSciResearcher/"
    "schemas/v2/mathematical-contract-registry.schema.json"
)

SCHEMA = {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": SCHEMA_ID,
    "title": "Versioned Mathematical Contract Registry",
    "type": "object",
    "additionalProperties": False,
    "required": [
        "schema_version",
        "schema_id",
        "language",
        "advisory_only",
        "solver_executed",
        "automatic_approval",
        "contracts",
    ],
    "$defs": {
        "nonEmptyString": {"type": "string", "minLength": 1},
        "localizedText": {
            "type": "object",
            "additionalProperties": False,
            "required": ["en", "zh-CN"],
            "properties": {
                "en": {"$ref": "#/$defs/nonEmptyString"},
                "zh-CN": {"$ref": "#/$defs/nonEmptyString"},
            },
        },
        "bilingualContract": {
            "type": "object",
            "additionalProperties": False,
            "required": [
                "contract_id",
                "title",
                "equation",
                "symbols",
                "decision_use",
                "implementation_relation",
            ],
            "properties": {
                "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "title": {"$ref": "#/$defs/localizedText"},
                "equation": {"$ref": "#/$defs/nonEmptyString"},
                "symbols": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"$ref": "#/$defs/localizedText"},
                },
                "decision_use": {"$ref": "#/$defs/localizedText"},
                "implementation_relation": {"$ref": "#/$defs/localizedText"},
            },
        },
        "localizedContract": {
            "type": "object",
            "additionalProperties": False,
            "required": [
                "contract_id",
                "title",
                "equation",
                "symbols",
                "decision_use",
                "implementation_relation",
            ],
            "properties": {
                "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "title": {"$ref": "#/$defs/nonEmptyString"},
                "equation": {"$ref": "#/$defs/nonEmptyString"},
                "symbols": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"$ref": "#/$defs/nonEmptyString"},
                },
                "decision_use": {"$ref": "#/$defs/nonEmptyString"},
                "implementation_relation": {"$ref": "#/$defs/nonEmptyString"},
            },
        },
    },
    "properties": {
        "schema_version": {"const": "1.0"},
        "schema_id": {"const": SCHEMA_ID},
        "language": {"enum": ["en", "zh-CN", "both"]},
        "advisory_only": {"const": True},
        "solver_executed": {"const": False},
        "automatic_approval": {"const": False},
        "contracts": {"type": "array", "minItems": 1, "items": {}},
    },
    "allOf": [
        {
            "if": {"properties": {"language": {"const": "both"}}},
            "then": {
                "properties": {
                    "contracts": {"items": {"$ref": "#/$defs/bilingualContract"}}
                }
            },
            "else": {
                "properties": {
                    "contracts": {"items": {"$ref": "#/$defs/localizedContract"}}
                }
            },
        }
    ],
}

schema_text = json.dumps(SCHEMA, ensure_ascii=False, indent=2) + "\n"
write("schemas/v2/mathematical-contract-registry.schema.json", schema_text)
write("tsao_researcher/data/schemas/mathematical-contract-registry.schema.json", schema_text)

replace_once(
    "scripts/sync_runtime_data.py",
    '    ROOT / "routing/router-rules-v2.json": ROOT / "tsao_researcher/data/routing/router-rules-v2.json",\n}',
    '    ROOT / "routing/router-rules-v2.json": ROOT / "tsao_researcher/data/routing/router-rules-v2.json",\n'
    '    ROOT / "schemas/v2/mathematical-contract-registry.schema.json": ROOT / "tsao_researcher/data/schemas/mathematical-contract-registry.schema.json",\n}',
)

replace_once(
    "tsao_researcher/mathematical_contracts.py",
    "from copy import deepcopy\nfrom typing import Any, Literal\n",
    "import json\nfrom copy import deepcopy\nfrom functools import lru_cache\n"
    "from importlib.resources import files\nfrom typing import Any, Literal\n\n"
    "import jsonschema\n",
)
replace_once(
    "tsao_researcher/mathematical_contracts.py",
    '_SCHEMA_VERSION = "1.0"\n',
    '_SCHEMA_VERSION = "1.0"\n'
    '_SCHEMA_ID = "https://sunhaojun22.github.io/TsaoSciResearcher/schemas/v2/mathematical-contract-registry.schema.json"\n'
    '_SCHEMA_RESOURCE = "data/schemas/mathematical-contract-registry.schema.json"\n',
)

schema_functions = r'''


@lru_cache(maxsize=1)
def _load_mathematical_contract_schema() -> dict[str, Any]:
    resource = files("tsao_researcher").joinpath(_SCHEMA_RESOURCE)
