    '    if len(VISUAL_ATLAS_ASSETS) != 38 or len(set(VISUAL_ATLAS_ASSETS)) != len(VISUAL_ATLAS_ASSETS):\n'
    '        errors.append("visual atlas must contain exactly 38 unique AI diagrams")',
)

