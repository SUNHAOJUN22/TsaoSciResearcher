{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SUNHAOJUN22/TsaoSciComputation/schemas/solver-capability-evidence.schema.json",
  "title": "Solver capability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_slug",
    "declared_executables",
    "detected",
    "executable_name",
    "executable_path",
    "executable_sha256",
    "executable_size_bytes",
    "required_python_modules",
    "missing_python_modules",
    "version_arguments",
    "version_returncode",
    "version_text_sha256",
    "version_excerpt",
    "qualification_status",
    "reason",
    "claim_boundary",
    "evidence_sha256"
  ],
  "properties": {
    "adapter_slug": {"type": "string", "minLength": 1},
    "declared_executables": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "detected": {"type": "boolean"},
    "executable_name": {"type": ["string", "null"], "minLength": 1},
    "executable_path": {"type": ["string", "null"], "minLength": 1},
    "executable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "executable_size_bytes": {"type": ["integer", "null"], "minimum": 1},
    "required_python_modules": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "missing_python_modules": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "version_arguments": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "version_returncode": {"type": ["integer", "null"]},
    "version_text_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "version_excerpt": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
    "qualification_status": {
      "enum": [
        "candidate-only",
        "detected-incomplete",
        "fingerprinted-unqualified",
        "version-probed-unqualified"
      ]
    },
    "reason": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"detected": {"const": true}}, "required": ["detected"]},
      "then": {
        "properties": {
          "executable_name": {"type": "string", "minLength": 1},
          "executable_path": {"type": "string", "minLength": 1},
          "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "executable_size_bytes": {"type": "integer", "minimum": 1}
        }
      },
      "else": {
        "properties": {
          "executable_name": {"const": null},
          "executable_path": {"const": null},
          "executable_sha256": {"const": null},
          "executable_size_bytes": {"const": null},
          "missing_python_modules": {"maxItems": 0},
          "version_arguments": {"maxItems": 0},
          "version_returncode": {"const": null},
          "version_text_sha256": {"const": null},
          "version_excerpt": {"const": null},
          "qualification_status": {"const": "candidate-only"}
        }
      }
    },
    {
      "if": {
        "properties": {"qualification_status": {"const": "detected-incomplete"}},
        "required": ["qualification_status"]
      },
      "then": {
        "properties": {
          "detected": {"const": true},
          "missing_python_modules": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"qualification_status": {"const": "fingerprinted-unqualified"}},
        "required": ["qualification_status"]
      },
      "then": {
        "properties": {
          "detected": {"const": true},
          "missing_python_modules": {"maxItems": 0}
        },
        "not": {
          "properties": {
            "version_returncode": {"const": 0},
            "version_text_sha256": {"type": "string"}
          },
          "required": ["version_returncode", "version_text_sha256"]
        }
      }
    },
    {
      "if": {
        "properties": {"qualification_status": {"const": "version-probed-unqualified"}},
        "required": ["qualification_status"]
      },
      "then": {
        "properties": {
          "detected": {"const": true},
          "missing_python_modules": {"maxItems": 0},
          "version_arguments": {"minItems": 1},
          "version_returncode": {"const": 0},
          "version_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "version_excerpt": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  ]
}
