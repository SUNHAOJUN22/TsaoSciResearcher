{
  "$id": "https://github.com/SUNHAOJUN22/TsaoSciComputation/schemas/performance-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_boundary": {"minLength": 40, "type": "string"},
    "environment": {
      "additionalProperties": false,
      "properties": {
        "environment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "logical_cpu_count": {"minimum": 1, "type": "integer"},
        "machine": {"minLength": 1, "type": "string"},
        "operating_system": {"minLength": 1, "type": "string"},
        "processor": {"minLength": 1, "type": "string"},
        "python_implementation": {"minLength": 1, "type": "string"},
        "python_version": {"minLength": 1, "type": "string"}
      },
      "required": [
        "python_version",
        "python_implementation",
        "operating_system",
        "machine",
        "processor",
        "logical_cpu_count",
        "environment_sha256"
      ],
      "type": "object"
    },
    "profile_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "1.0"},
    "workloads": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "input_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "median_wall_seconds": {"minimum": 0, "type": "number"},
          "repeats": {"minimum": 1, "type": "integer"},
          "samples": {"minItems": 1, "type": "array"},
          "slug": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"}
        },
        "required": [
          "slug",
          "description",
          "repeats",
          "samples",
          "median_wall_seconds",
          "input_sha256",
          "claim_boundary"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "environment",
    "workloads",
    "profile_sha256",
    "claim_boundary"
  ],
  "title": "TsaoSciComputation runtime performance profile",
  "type": "object"
}
