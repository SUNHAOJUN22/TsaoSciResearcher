{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunhaojun22.github.io/TsaoSciResearcher/schemas/v2/computation-strategy.schema.json",
  "title": "First-Principles Strategy with Scientific Passport and Decision Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_id",
    "status",
    "question",
    "observables",
    "conditions",
    "constraints",
    "available_evidence",
    "classification",
    "first_principles_frame",
    "method_ladder",
    "cross_scale_plan",
    "validation_plan",
    "uncertainty_plan",
    "decision_rules",
    "human_review",
    "execution_boundary",
    "scientific_passport",
    "integrity_gates",
    "decision_readiness"
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "role",
        "family",
        "representative_methods",
        "target_observables",
        "rationale",
        "assumptions",
        "required_inputs",
        "validation",
        "falsification",
        "uncertainty",
        "escalate_if"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "minimum-sufficient",
            "escalation",
            "cross-regime-bridge"
          ]
        },
        "family": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "representative_methods": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "target_observables": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "assumptions": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "required_inputs": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "validation": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "falsification": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "uncertainty": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "escalate_if": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^FPS-[0-9a-f]{16}$"
    },
    "status": {
      "const": "advisory-only"
    },
    "question": {
      "type": "string",
      "minLength": 3
    },
    "observables": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "conditions": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "constraints": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "available_evidence": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_regime",
        "primary_name_zh",
        "primary_name_en",
        "selected_regimes",
        "scores",
        "clarification_required",
        "clarification_questions"
      ],
      "properties": {
        "primary_regime": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "primary_name_zh": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "primary_name_en": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "selected_regimes": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "scores": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "clarification_required": {
          "type": "boolean"
        },
        "clarification_questions": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    },
    "first_principles_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "degrees_of_freedom",
        "governing_principles",
        "conserved_quantities",
        "symmetries_and_constraints",
        "state_variables",
        "thermodynamic_potential",
        "statistical_ensemble",
        "equilibrium_status",
        "length_scales",
        "time_scales",
        "dimensionless_or_scale_tests",
        "reduction_assumptions"
      ],
      "properties": {
        "degrees_of_freedom": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "governing_principles": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "conserved_quantities": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "symmetries_and_constraints": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "state_variables": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "thermodynamic_potential": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "statistical_ensemble": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "equilibrium_status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "length_scales": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "time_scales": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "dimensionless_or_scale_tests": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "reduction_assumptions": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "method_ladder": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method"
      },
      "minItems": 2
    },
    "cross_scale_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "secondary_regimes",
        "bridge_variables",
        "coupling_rule"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "secondary_regimes": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "bridge_variables": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "coupling_rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "validation_plan": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "uncertainty_plan": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "decision_rules": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "human_review": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver_executed",
        "external_execution_required",
        "statement",
        "next_step"
      ],
      "properties": {
        "solver_executed": {
          "const": false
        },
        "external_execution_required": {
          "const": true
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "next_step": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "scientific_passport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passport_version",
        "strategy_id",
        "model_contract",
        "bridge_contract",
        "evidence_contract",
        "claim_contract",
        "quantity_dimension_contract",
        "applicability_contract",
        "evidence_conflict_contract",
        "identifiability_contract",
        "uncertainty_contract"
      ],
      "properties": {
        "passport_version": {
          "const": "1.2"
        },
        "strategy_id": {
          "type": "string",
          "pattern": "^FPS-[0-9a-f]{16}$"
        },
        "model_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_variables",
            "governing_principles",
            "assumptions",
            "applicability_domain",
            "failure_conditions"
          ],
          "properties": {
            "state_variables": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "governing_principles": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "assumptions": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "applicability_domain": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "failure_conditions": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "bridge_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "source_regimes",
            "bridge_variables",
            "acceptance_tests"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "source_regimes": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "bridge_variables": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "acceptance_tests": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "evidence_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification_basis",
            "declared_only",
            "maturity_rank",
            "maturity_level",
            "levels_detected",
            "evidence_items",
            "evidence_inventory",
            "minimum_next_evidence"
          ],
          "properties": {
            "classification_basis": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "declared_only": {
              "const": true
            },
            "maturity_rank": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "maturity_level": {
              "enum": [
                "E0-hypothesis-only",
                "E1-theoretical",
                "E2-computational",
                "E3-experimental",
                "E4-industrial"
              ]
            },
            "levels_detected": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "evidence_items": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "minimum_next_evidence": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "evidence_inventory": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_id",
                  "statement",
                  "declared_rank",
                  "declared_level",
                  "matched_markers",
                  "verification_status"
                ],
                "properties": {
                  "evidence_id": {
                    "type": "string",
                    "pattern": "^EVI-[0-9a-f]{12}$"
                  },
                  "statement": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "declared_rank": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "declared_level": {
                    "enum": [
                      "E0-hypothesis-only",
                      "E1-theoretical",
                      "E2-computational",
                      "E3-experimental",
                      "E4-industrial"
                    ]
                  },
                  "matched_markers": {
                    "$ref": "#/$defs/uniqueStrings"
                  },
                  "verification_status": {
                    "const": "declared-unverified"
                  }
                }
              },
              "uniqueItems": true
            }
          }
        },
        "uncertainty_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "categories",
            "propagation_target",
            "acceptance_rule"
          ],
          "properties": {
            "categories": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "propagation_target": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "acceptance_rule": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "claim_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_type",
            "triggers",
            "minimum_evidence_rank",
            "observed_evidence_rank",
            "status",
            "required_evidence",
            "language_boundary"
          ],
          "properties": {
            "claim_type": {
              "enum": [
                "descriptive",
                "predictive",
                "mechanistic",
                "causal"
              ]
            },
            "triggers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "minimum_evidence_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "observed_evidence_rank": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "status": {
              "enum": [
                "insufficient",
                "guarded",
                "baseline-met"
              ]
            },
            "required_evidence": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "language_boundary": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "quantity_dimension_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "parsed_quantities",
            "missing_unit_statements",
            "dimension_conflicts",
            "unit_variations",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required",
                "blocked"
              ]
            },
            "parsed_quantities": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement",
                  "label",
                  "value",
                  "unit",
                  "normalized_unit",
                  "dimension"
                ],
                "properties": {
                  "statement": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "label": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
                  },
                  "unit": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "normalized_unit": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "dimension": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                }
              }
            },
            "missing_unit_statements": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "dimension_conflicts": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "unit_variations": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "applicability_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "explicit_extrapolation",
            "extrapolation_markers",
            "declared_domain",
            "transfer_evidence_markers",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required",
                "blocked"
              ]
            },
            "explicit_extrapolation": {
              "type": "boolean"
            },
            "extrapolation_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "declared_domain": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "transfer_evidence_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "evidence_conflict_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "conflict_detected",
            "supporting_evidence_ids",
            "challenging_evidence_ids",
            "neutral_evidence_ids",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required"
              ]
            },
            "conflict_detected": {
              "type": "boolean"
            },
            "supporting_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EVI-[0-9a-f]{12}$"
              },
              "uniqueItems": true
            },
            "challenging_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EVI-[0-9a-f]{12}$"
              },
              "uniqueItems": true
            },
            "neutral_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EVI-[0-9a-f]{12}$"
              },
              "uniqueItems": true
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "identifiability_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "warning_markers",
            "comparison_markers",
            "discriminating_observables",
            "minimum_alternatives",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required",
                "blocked"
              ]
            },
            "warning_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "comparison_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "discriminating_observables": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "minimum_alternatives": {
              "type": "integer",
              "minimum": 1
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        }
      }
    },
    "integrity_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "causal_claim",
        "scale_jump",
        "quantity_dimension",
        "applicability_extrapolation",
        "evidence_conflict",
        "identifiability",
        "mechanism_competition"
      ],
      "properties": {
        "causal_claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "triggers",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-triggered",
                "review-required",
                "guarded"
              ]
            },
            "triggers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "scale_jump": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source_regime",
            "source_tier",
            "target_tier",
            "tier_gap",
            "target_markers",
            "bridge_variables",
            "missing_bridge_requirements"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required",
                "blocked"
              ]
            },
            "source_regime": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "source_tier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "target_tier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "tier_gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "target_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "bridge_variables": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "missing_bridge_requirements": {
              "$ref": "#/$defs/uniqueStrings"
            }
          }
        },
        "mechanism_competition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "rule",
            "minimum_alternatives"
          ],
          "properties": {
            "status": {
              "const": "required"
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "minimum_alternatives": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "quantity_dimension": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "parsed_quantities",
            "missing_unit_statements",
            "dimension_conflicts",
            "unit_variations",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required",
                "blocked"
              ]
            },
            "parsed_quantities": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement",
                  "label",
                  "value",
                  "unit",
                  "normalized_unit",
                  "dimension"
                ],
                "properties": {
                  "statement": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "label": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
                  },
                  "unit": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "normalized_unit": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "dimension": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                }
              }
            },
            "missing_unit_statements": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "dimension_conflicts": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "unit_variations": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "applicability_extrapolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "explicit_extrapolation",
            "extrapolation_markers",
            "declared_domain",
            "transfer_evidence_markers",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required",
                "blocked"
              ]
            },
            "explicit_extrapolation": {
              "type": "boolean"
            },
            "extrapolation_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "declared_domain": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "transfer_evidence_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "evidence_conflict": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "conflict_detected",
            "supporting_evidence_ids",
            "challenging_evidence_ids",
            "neutral_evidence_ids",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required"
              ]
            },
            "conflict_detected": {
              "type": "boolean"
            },
            "supporting_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EVI-[0-9a-f]{12}$"
              },
              "uniqueItems": true
            },
            "challenging_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EVI-[0-9a-f]{12}$"
              },
              "uniqueItems": true
            },
            "neutral_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EVI-[0-9a-f]{12}$"
              },
              "uniqueItems": true
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "identifiability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "warning_markers",
            "comparison_markers",
            "discriminating_observables",
            "minimum_alternatives",
            "rule",
            "required_checks"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "review-required",
                "blocked"
              ]
            },
            "warning_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "comparison_markers": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "discriminating_observables": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "minimum_alternatives": {
              "type": "integer",
              "minimum": 1
            },
            "rule": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required_checks": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        }
      }
    },
    "decision_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "automatic_approval",
        "human_review_required",
        "blocking_codes",
        "review_codes",
        "next_best_evidence",
        "handoff_rule"
      ],
      "properties": {
        "status": {
          "enum": [
            "blocked",
            "review-required",
            "ready-for-human-review"
          ]
        },
        "automatic_approval": {
          "const": false
        },
        "human_review_required": {
          "const": true
        },
        "blocking_codes": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "review_codes": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "next_best_evidence": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "handoff_rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
