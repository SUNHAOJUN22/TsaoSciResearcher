{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsao.dev/skills/poe/schemas/process_case.schema.json",
  "title": "TSAO process case with material-balance contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "mode",
    "balance_basis",
    "components",
    "streams",
    "equipment",
    "balance",
    "accumulation",
    "property_method",
    "convergence",
    "source_asset_sha256",
    "acceptance_criteria"
  ],
  "$defs": {
    "basis": { "enum": ["mass", "molar"] },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "basis"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/basis" }
      }
    },
    "componentQuantityMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/quantity" }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "from",
        "to",
        "flow",
        "composition_basis",
        "composition"
      ],
      "properties": {
        "stream_id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "flow": { "$ref": "#/$defs/quantity" },
        "composition_basis": { "enum": ["mass_fraction", "mole_fraction"] },
        "composition": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "is_recycle": { "type": "boolean" },
        "closed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "flow": { "properties": { "basis": { "const": "mass" } } } }
          },
          "then": { "properties": { "composition_basis": { "const": "mass_fraction" } } }
        },
        {
          "if": {
            "properties": { "flow": { "properties": { "basis": { "const": "molar" } } } }
          },
          "then": { "properties": { "composition_basis": { "const": "mole_fraction" } } }
        }
      ]
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction_id", "stoichiometry", "extent"],
      "properties": {
        "reaction_id": { "type": "string", "minLength": 1 },
        "stoichiometry": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "not": { "const": 0 } }
        },
        "extent": {
          "allOf": [
            { "$ref": "#/$defs/quantity" },
            { "properties": { "basis": { "const": "molar" } } }
          ]
        }
      }
    },
    "balance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_tolerance", "reference_scales"],
      "properties": {
        "steady_state_declared": { "type": "boolean" },
        "absolute_tolerance": { "$ref": "#/$defs/quantity" },
        "absolute_tolerances": { "$ref": "#/$defs/componentQuantityMap" },
        "relative_tolerance": { "type": "number", "minimum": 0, "maximum": 1 },
        "reference_scales": { "$ref": "#/$defs/componentQuantityMap" }
      },
      "oneOf": [
        { "required": ["absolute_tolerance"], "not": { "required": ["absolute_tolerances"] } },
        { "required": ["absolute_tolerances"], "not": { "required": ["absolute_tolerance"] } }
      ]
    }
  },
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["steady", "dynamic"] },
    "balance_basis": { "$ref": "#/$defs/basis" },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stream" }
    },
    "equipment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["equipment_id", "type"],
        "properties": {
          "equipment_id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "balance": { "$ref": "#/$defs/balance" },
    "accumulation": { "$ref": "#/$defs/componentQuantityMap" },
    "reactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/reaction" }
    },
    "molecular_weights_g_mol": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "property_method": { "type": "object" },
    "property_query": { "type": "object" },
    "convergence": { "type": "boolean" },
    "source_asset_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "controllers": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "valves": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "volumes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "initial_conditions": { "type": "object", "minProperties": 1 },
    "disturbances": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "dynamic_assets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "claims": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "steady" } } },
      "then": {
        "properties": {
          "balance": { "required": ["steady_state_declared"], "properties": { "steady_state_declared": { "const": true } } }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "dynamic" } } },
      "then": {
        "required": ["dynamic_assets", "controllers", "valves", "volumes", "initial_conditions", "disturbances"]
      }
    }
  ]
}
