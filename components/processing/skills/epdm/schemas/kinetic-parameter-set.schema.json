{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsao.example/schemas/v2/kinetic-parameter-set.schema.json",
  "title": "EPDM V2 kinetic parameter set",
  "type": "object",
  "required": [
    "parameter_set_id",
    "catalyst_id",
    "diene_id",
    "applicability_domain_id",
    "rate_laws",
    "parameters",
    "evidence_ids"
  ],
  "properties": {
    "parameter_set_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "catalyst_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "diene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "applicability_domain_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "rate_laws": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rate_law_id",
          "expression_id",
          "reactant_orders",
          "concentration_basis",
          "rate_output_basis",
          "temperature_form",
          "parameter_roles"
        ],
        "properties": {
          "rate_law_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "expression_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "reactant_orders": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "concentration_basis": {
            "enum": [
              "MOLARITY",
              "MOLALITY",
              "FUGACITY",
              "PARTIAL_PRESSURE"
            ]
          },
          "rate_output_basis": {
            "enum": [
              "PER_REACTOR_VOLUME",
              "PER_CATALYST_MASS",
              "PER_ACTIVE_SITE"
            ]
          },
          "temperature_form": {
            "enum": [
              "CONSTANT",
              "ARRHENIUS_KREF",
              "ARRHENIUS_PREEXPONENTIAL"
            ]
          },
          "parameter_roles": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "parameter_id",
          "reaction_id",
          "rate_law_id",
          "parameter_role",
          "value",
          "unit",
          "stored_quantity_kind",
          "lower_bound",
          "upper_bound",
          "evidence_id",
          "estimated",
          "scope",
          "maturity",
          "applicability_domain_id"
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "reaction_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "rate_law_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "parameter_role": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "enum": [
              "1",
              "K",
              "Pa",
              "s",
              "mol",
              "mol/s",
              "kg",
              "kg/s",
              "m",
              "m^2",
              "m^3",
              "m^3/s",
              "J",
              "W",
              "J/K",
              "J/mol",
              "kg/mol",
              "kg/m^3",
              "mol/m^3",
              "mol/kg",
              "1/s",
              "m^3/(mol*s)",
              "Pa^-1*s^-1"
            ]
          },
          "stored_quantity_kind": {
            "enum": [
              "K_REF",
              "PREEXPONENTIAL_FACTOR",
              "ACTIVATION_ENERGY",
              "DIMENSIONLESS"
            ]
          },
          "reference_temperature_K": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "lower_bound": {
            "type": "number"
          },
          "upper_bound": {
            "type": "number"
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "estimated": {
            "type": "boolean"
          },
          "scope": {
            "enum": [
              "GLOBAL",
              "SITE",
              "GRADE_CORRECTION",
              "REACTOR_CORRECTION"
            ]
          },
          "maturity": {
            "enum": [
              "ASSUMED",
              "LITERATURE_PRIOR",
              "LAB_CALIBRATED",
              "PILOT_CALIBRATED",
              "PLANT_CALIBRATED",
              "INDEPENDENTLY_VALIDATED",
              "APPROVED"
            ]
          },
          "applicability_domain_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "standard_error": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "confidence_interval_95": {
            "oneOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "covariance_group_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "uncertainty_method": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "stored_quantity_kind": {
                  "enum": [
                    "K_REF",
                    "PREEXPONENTIAL_FACTOR"
                  ]
                }
              },
              "required": [
                "stored_quantity_kind"
              ]
            },
            "then": {
              "required": [
                "reference_temperature_K"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
