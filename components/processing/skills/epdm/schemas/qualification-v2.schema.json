{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsao.example/schemas/v2/qualification-v2.schema.json",
  "title": "EPDM V2 layered qualification",
  "type": "object",
  "required": [
    "software_status",
    "thermodynamic_status",
    "kinetic_calibration_status",
    "independent_validation_status",
    "engineering_use_status",
    "gate_results"
  ],
  "properties": {
    "software_status": {
      "enum": [
        "NOT_EVALUATED",
        "HOLD",
        "CONDITIONAL",
        "PASS",
        "FAIL"
      ]
    },
    "thermodynamic_status": {
      "enum": [
        "NOT_EVALUATED",
        "HOLD",
        "CONDITIONAL",
        "PASS",
        "FAIL"
      ]
    },
    "kinetic_calibration_status": {
      "enum": [
        "NOT_EVALUATED",
        "HOLD",
        "CONDITIONAL",
        "PASS",
        "FAIL"
      ]
    },
    "independent_validation_status": {
      "enum": [
        "NOT_EVALUATED",
        "HOLD",
        "CONDITIONAL",
        "PASS",
        "FAIL"
      ]
    },
    "engineering_use_status": {
      "enum": [
        "NOT_EVALUATED",
        "HOLD",
        "CONDITIONAL",
        "PASS",
        "FAIL"
      ]
    },
    "gate_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gateResult"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "extensions": {
      "type": "object"
    },
    "model_generation": {
      "enum": [
        "V1_LUMPED_REFERENCE",
        "V2_TERMINAL_MOMENT",
        "V2_HYBRID_CONSTRAINED"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "gateResult": {
      "type": "object",
      "required": [
        "gate_id",
        "layer",
        "decision",
        "reason_code",
        "applicable",
        "mandatory",
        "criterion_id"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "layer": {
          "enum": [
            "SOFTWARE",
            "THERMODYNAMIC",
            "KINETIC_CALIBRATION",
            "INDEPENDENT_VALIDATION",
            "ENGINEERING_USE"
          ]
        },
        "decision": {
          "enum": [
            "PASS",
            "HOLD",
            "FAIL",
            "NOT_EVALUATED",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {
          "enum": [
            "NONE",
            "MISSING_EVIDENCE",
            "INVALID_UNIT_BASIS",
            "BLOCKED_BY_THERMODYNAMICS",
            "EXTRAPOLATION",
            "NONIDENTIFIABLE",
            "NONCONVERGED",
            "NUMERICAL_CONSERVATION",
            "UNSUPPORTED_TOPOLOGY",
            "DATA_LEAKAGE",
            "APPROVAL_MISSING",
            "OUT_OF_TRAINING_DOMAIN",
            "SEMANTIC_REFERENCE_UNRESOLVED",
            "SOLVER_CAPABILITY_MISMATCH",
            "EVENT_LOCALIZATION_UNSUPPORTED",
            "MODEL_SELECTION_INCONCLUSIVE",
            "ILLEGAL_PARAMETER_BINDING",
            "MIXED_STATE_BASIS"
          ]
        },
        "applicable": {
          "type": "boolean"
        },
        "mandatory": {
          "type": "boolean"
        },
        "criterion_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "measured_metrics": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "additionalProperties": {
            "$ref": "quantity-value.schema.json"
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
