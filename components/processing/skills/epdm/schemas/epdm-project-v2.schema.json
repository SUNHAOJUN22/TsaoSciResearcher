{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsao.example/schemas/v2/epdm-project-v2.schema.json",
  "title": "EPDM Scientific Kernel V2 project",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "evidence_ledger",
    "applicability_domains",
    "catalyst_passports",
    "diene_passports",
    "thermo_passports",
    "kinetic_parameter_sets",
    "state_definitions",
    "datasets",
    "calibration_plans",
    "cases",
    "qualification",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "$ref": "evidence-reference.schema.json"
      }
    },
    "applicability_domains": {
      "type": "array",
      "items": {
        "$ref": "applicability-domain.schema.json"
      }
    },
    "catalyst_passports": {
      "type": "array",
      "items": {
        "$ref": "catalyst-passport.schema.json"
      }
    },
    "diene_passports": {
      "type": "array",
      "items": {
        "$ref": "diene-passport.schema.json"
      }
    },
    "thermo_passports": {
      "type": "array",
      "items": {
        "$ref": "thermo-passport.schema.json"
      }
    },
    "kinetic_parameter_sets": {
      "type": "array",
      "items": {
        "$ref": "kinetic-parameter-set.schema.json"
      }
    },
    "state_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "state_definition_id",
          "version",
          "basis",
          "energy_formulation",
          "variables"
        ],
        "properties": {
          "state_definition_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "EXTENSIVE_REACTOR_AMOUNT",
              "AXIAL_MOLAR_FLOW",
              "INTENSIVE_REFERENCE_FIXTURE"
            ]
          },
          "energy_formulation": {
            "enum": [
              "TOTAL_ENTHALPY",
              "INTERNAL_ENERGY",
              "ISOTHERMAL",
              "DIRECT_TEMPERATURE_REFERENCE"
            ]
          },
          "variables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "variable_id",
                "description",
                "unit",
                "basis",
                "level_minimum",
                "site_family_indexed",
                "terminal_indexed"
              ],
              "properties": {
                "variable_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "enum": [
                    "1",
                    "K",
                    "Pa",
                    "s",
                    "mol",
                    "mol/s",
                    "kg",
                    "kg/s",
                    "m",
                    "m^2",
                    "m^3",
                    "m^3/s",
                    "J",
                    "W",
                    "J/K",
                    "J/mol",
                    "kg/mol",
                    "kg/m^3",
                    "mol/m^3",
                    "mol/kg",
                    "1/s",
                    "m^3/(mol*s)",
                    "Pa^-1*s^-1"
                  ]
                },
                "basis": {
                  "enum": [
                    "EXTENSIVE_REACTOR_AMOUNT",
                    "AXIAL_MOLAR_FLOW",
                    "INTENSIVE_REFERENCE_FIXTURE"
                  ]
                },
                "level_minimum": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "site_family_indexed": {
                  "type": "boolean"
                },
                "terminal_indexed": {
                  "type": "boolean"
                },
                "conserved_inventory_id": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "reaction_networks": {
      "type": "array",
      "items": {
        "$ref": "reaction-network-v2.schema.json"
      }
    },
    "reactor_networks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "kinetic-dataset.schema.json"
      }
    },
    "gpc_datasets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "calibration_plans": {
      "type": "array",
      "items": {
        "$ref": "calibration-plan.schema.json"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "epdm-case-v2.schema.json"
      }
    },
    "qualification": {
      "$ref": "qualification-v2.schema.json"
    },
    "extensions": {
      "type": "object"
    },
    "generated_state_definitions": {
      "type": "array",
      "items": {
        "$ref": "generated-state-definition.schema.json"
      }
    }
  },
  "additionalProperties": false
}
