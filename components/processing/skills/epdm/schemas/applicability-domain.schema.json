{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsao.example/schemas/v2/applicability-domain.schema.json",
  "title": "EPDM V2 applicability domain",
  "type": "object",
  "required": [
    "applicability_domain_id",
    "temperature_K",
    "pressure_Pa",
    "ethylene_fraction",
    "propylene_fraction",
    "diene_fraction",
    "hydrogen_ratio",
    "reactor_types",
    "catalyst_ids",
    "diene_ids"
  ],
  "properties": {
    "applicability_domain_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "temperature_K": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "pressure_Pa": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ethylene_fraction": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "propylene_fraction": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "diene_fraction": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "hydrogen_ratio": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "reactor_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "BATCH",
          "SEMIBATCH",
          "CSTR",
          "CSTR_SERIES",
          "PFR",
          "HSBR_CSTR_SERIES",
          "GAS_PHASE_FBR_REFERENCE",
          "SOLUTION_CSTR"
        ]
      }
    },
    "catalyst_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "diene_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
