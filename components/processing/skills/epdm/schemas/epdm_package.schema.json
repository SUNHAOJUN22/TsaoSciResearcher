{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsao.example/schemas/epdm_package.schema.json",
  "title": "TSAO governed EPDM process package",
  "type": "object",
  "required": [
    "package_id",
    "process_family",
    "status",
    "tolerances",
    "design_basis",
    "streams",
    "equipment",
    "evidence_ledger",
    "epdm_case"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "process_family": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_EVALUATED",
        "HOLD",
        "CONDITIONAL",
        "PASS",
        "FAIL"
      ]
    },
    "tolerances": {
      "type": "object"
    },
    "design_basis": {
      "type": "object"
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "utilities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hse": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "status",
          "locator",
          "applicability"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "REPORTED",
              "CALCULATED",
              "QUALIFIED",
              "HOLD",
              "SUPERSEDED",
              "RETRACTED"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approvals": {
      "type": "object"
    },
    "epdm_case": {
      "$ref": "epdm_case.schema.json"
    }
  },
  "additionalProperties": false
}
