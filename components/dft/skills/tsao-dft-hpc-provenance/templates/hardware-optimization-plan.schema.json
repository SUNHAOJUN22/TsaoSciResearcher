{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tsao-dft/hardware-optimization-plan.schema.json",
  "title": "TsaoDFT hardware-aware optimization plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "schema_version",
    "profile_id",
    "engine",
    "stage",
    "target",
    "backend",
    "provider",
    "provider_contract",
    "expected_bottleneck",
    "resource_layout",
    "library_assessment",
    "assumptions",
    "validation_requirements",
    "evidence",
    "performance_evidence_status",
    "speedup_claim_allowed",
    "public_capability_change",
    "warnings",
    "non_claims"
  ],
  "properties": {
    "ok": {"const": true},
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "engine": {"enum": ["gaussian", "vasp", "quantum-espresso", "cp2k", "generic"]},
    "stage": {"enum": ["engine", "ml-surrogate", "postprocessing", "workflow"]},
    "target": {"enum": ["edge", "workstation", "hpc"]},
    "backend": {"enum": ["cpu", "cuda", "openacc", "hip", "sycl", "openmp-offload", "metal"]},
    "provider": {"enum": ["cpu", "engine-native", "array-api", "custom-native", "edge-runtime", "remote-dft"]},
    "provider_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "runtime",
        "engine_build_fingerprint_id",
        "cpu_fallback_required",
        "library_injection_forbidden",
        "remote_dft_fallback_required"
      ],
      "properties": {
        "status": {"const": "ELIGIBLE_PLAN"},
        "runtime": {"type": "string", "minLength": 1},
        "engine_build_fingerprint_id": {"type": "string", "minLength": 1},
        "cpu_fallback_required": {"const": true},
        "library_injection_forbidden": {"type": "boolean"},
        "remote_dft_fallback_required": {"type": "boolean"}
      }
    },
    "expected_bottleneck": {
      "enum": ["fft", "dense-solve", "sparse", "tensor", "communication", "io", "transfer", "unknown"]
    },
    "resource_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "mpi_ranks_per_node",
        "openmp_threads",
        "gpus_per_node",
        "ranks_per_gpu",
        "binding"
      ],
      "properties": {
        "nodes": {"type": "integer", "minimum": 1},
        "mpi_ranks_per_node": {"type": "integer", "minimum": 1},
        "openmp_threads": {"type": "integer", "minimum": 1},
        "gpus_per_node": {"type": "integer", "minimum": 0},
        "ranks_per_gpu": {"type": "integer", "minimum": 0},
        "binding": {"type": "string", "minLength": 1}
      }
    },
    "library_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "vendor", "category", "requested", "availability", "decision", "reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "vendor": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "requested": {"type": "boolean"},
          "availability": {"enum": ["NOT_AVAILABLE", "SIMULATED_AVAILABLE", "DECLARED_AVAILABLE"]},
          "decision": {"enum": ["recommended", "optional", "blocked"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "labels", "real_hardware_verified", "real_engine_verified"],
      "properties": {
        "source_kind": {"enum": ["simulation", "observed"]},
        "labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "real_hardware_verified": {"const": false},
        "real_engine_verified": {"const": false}
      }
    },
    "performance_evidence_status": {"const": "NOT_PERFORMANCE_EVIDENCE"},
    "speedup_claim_allowed": {"const": false},
    "public_capability_change": {"const": false},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
