{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TsaoDFT execution approval attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestation_id", "identity", "decision", "scope", "issued_at", "expires_at", "binding", "signature_algorithm", "key_fingerprint", "signature"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "attestation_id": {"type": "string", "minLength": 1},
    "identity": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected"]},
    "scope": {"const": "execute-reviewed-manifest"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "benchmark_plan_id", "candidate_id", "method_fingerprint_digest"],
      "properties": {
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "benchmark_plan_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "method_fingerprint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "signature_algorithm": {"const": "ed25519"},
    "key_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 32}
  }
}
