{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SUNHAOJUN22/TsaoDFT_skill/compute-qualification-campaign-v1.0.schema.json",
  "$comment": "LEGACY COMPATIBILITY CONTRACT: compute qualification campaign v1.0. It is accepted only by the central adapter.",
  "title": "TsaoDFT legacy compute qualification campaign v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "benchmark_plan_id",
    "engine",
    "reference_candidate_id",
    "candidate_ids",
    "minimum_repeats",
    "minimum_reference_over_candidate_ratio",
    "numerical_tolerances"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "benchmark_plan_id": {"type": "string", "minLength": 1},
    "engine": {
      "enum": ["gaussian", "vasp", "quantum-espresso", "cp2k", "generic", "ml-surrogate"]
    },
    "reference_candidate_id": {"type": "string", "minLength": 1},
    "candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "minimum_repeats": {"type": "integer", "minimum": 3},
    "minimum_reference_over_candidate_ratio": {"type": "number", "exclusiveMinimum": 1},
    "numerical_tolerances": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {"^.+$": {"$ref": "#/$defs/tolerance"}},
      "additionalProperties": false
    }
  },
  "$defs": {
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": {"type": "number", "minimum": 0},
        "relative": {"type": "number", "minimum": 0}
      }
    }
  }
}
