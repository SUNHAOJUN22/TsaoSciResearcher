{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SUNHAOJUN22/TsaoDFT_skill/benchmark-result.schema.json",
  "$comment": "AUTHORITATIVE CONTRACT: nested benchmark evidence v1.1. Root copies must be byte-identical mirrors.",
  "title": "TsaoDFT canonical nested benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_plan_id",
    "candidate_id",
    "role",
    "repeat_index",
    "engine",
    "software",
    "hardware",
    "execution",
    "scientific",
    "performance",
    "artifacts",
    "evidence_source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "benchmark_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "scientific-reference",
        "acceleration-candidate"
      ]
    },
    "repeat_index": {
      "type": "integer",
      "minimum": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "executable",
        "build_fingerprint_id"
      ],
      "properties": {
        "name": {
          "enum": [
            "gaussian",
            "vasp",
            "quantum-espresso",
            "cp2k",
            "generic"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "build_fingerprint_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "mpi",
        "openmp_runtime",
        "accelerator_runtime"
      ],
      "properties": {
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "mpi": {
          "type": "string",
          "minLength": 1
        },
        "openmp_runtime": {
          "type": "string",
          "minLength": 1
        },
        "accelerator_runtime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "hardware_fingerprint_id",
        "cpu_model",
        "cpu_arch",
        "nodes",
        "ranks_per_node",
        "threads_per_rank",
        "gpu_vendor",
        "gpu_model",
        "gpu_uuids",
        "gpu_memory_gb",
        "driver_version",
        "gpu_binding"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "hardware_fingerprint_id": {
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "cpu_arch": {
          "enum": [
            "x86_64",
            "aarch64",
            "arm64",
            "ppc64le",
            "other"
          ]
        },
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "ranks_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "threads_per_rank": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_vendor": {
          "enum": [
            "none",
            "nvidia",
            "amd",
            "intel",
            "apple"
          ]
        },
        "gpu_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_uuids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "gpu_memory_gb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "driver_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_binding": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduler",
        "job_id",
        "run_id",
        "site_id",
        "filesystem",
        "scratch_type",
        "timestamp",
        "exit_status"
      ],
      "properties": {
        "scheduler": {
          "enum": [
            "local",
            "slurm",
            "pbs",
            "other"
          ]
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "scratch_type": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "exit_status": {
          "type": "integer"
        }
      }
    },
    "scientific": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_sha256",
        "method_fingerprint_id",
        "model_identity",
        "convergence_thresholds",
        "observable_set",
        "parser_accepted",
        "parser_status",
        "results"
      ],
      "properties": {
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method_fingerprint_id": {
          "type": "string",
          "minLength": 1
        },
        "model_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "functional",
            "basis_or_pseudopotential",
            "corrections"
          ],
          "properties": {
            "functional": {
              "type": "string",
              "minLength": 1
            },
            "basis_or_pseudopotential": {
              "type": "string",
              "minLength": 1
            },
            "corrections": {
              "type": "string"
            }
          }
        },
        "convergence_thresholds": {
          "type": "object",
          "minProperties": 1
        },
        "observable_set": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "parser_accepted": {
          "type": "boolean"
        },
        "parser_status": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "energy_ev",
            "forces_ev_per_angstrom",
            "stress_gpa",
            "properties"
          ],
          "properties": {
            "energy_ev": {
              "type": [
                "number",
                "null"
              ]
            },
            "forces_ev_per_angstrom": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number"
              }
            },
            "stress_gpa": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number"
              }
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_s",
        "cpu_time_s",
        "scf_iterations",
        "peak_host_memory_mb",
        "peak_device_memory_mb",
        "cpu_utilization_percent",
        "gpu_utilization_percent",
        "io_bytes",
        "energy_joules"
      ],
      "properties": {
        "wall_time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpu_time_s": {
          "type": "number",
          "minimum": 0
        },
        "scf_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "peak_host_memory_mb": {
          "type": "number",
          "minimum": 0
        },
        "peak_device_memory_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cpu_utilization_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gpu_utilization_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "io_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "energy_joules": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verification_status": {
            "enum": [
              "VERIFIED",
              "NOT_CHECKED",
              "MISSING",
              "MISMATCH"
            ]
          },
          "observed_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_id",
        "missing_fields"
      ],
      "properties": {
        "kind": {
          "enum": [
            "real-engine",
            "synthetic-template",
            "test-fixture",
            "imported-unverified"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
