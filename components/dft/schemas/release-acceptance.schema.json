{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SUNHAOJUN22/TsaoDFT_skill/schemas/release-acceptance.schema.json",
  "title": "TsaoDFT repository software release acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "schema_version",
    "release",
    "software_acceptance",
    "external_execution",
    "quality_gate_contract",
    "ci_contract",
    "compute_contract_evidence_source",
    "artifacts",
    "errors",
    "non_claims"
  ],
  "properties": {
    "ok": {"type": "boolean"},
    "schema_version": {"const": "1.0"},
    "release": {"type": ["string", "null"], "minLength": 1},
    "software_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "scope",
        "quality_gate_stage_count",
        "quality_gate_contract_complete",
        "capability_count",
        "all_capabilities_at_least_l2",
        "capability_levels"
      ],
      "properties": {
        "state": {"enum": ["SOFTWARE_PREFLIGHT_READY", "UNQUALIFIED"]},
        "scope": {"type": "string", "minLength": 1},
        "quality_gate_stage_count": {"type": "integer", "minimum": 0},
        "quality_gate_contract_complete": {"type": "boolean"},
        "capability_count": {"type": "integer", "minimum": 0},
        "all_capabilities_at_least_l2": {"type": "boolean"},
        "capability_levels": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "external_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "engine_invoked",
        "performance_evaluated",
        "performance_ratio_published",
        "required_evidence",
        "declared_external_requirements"
      ],
      "properties": {
        "state": {"const": "EXTERNAL_HOLD"},
        "engine_invoked": {"const": false},
        "performance_evaluated": {"const": false},
        "performance_ratio_published": {"const": false},
        "required_evidence": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "declared_external_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "quality_gate_contract": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ci_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs", "python_versions", "windows_runner"],
      "properties": {
        "jobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "python_versions": {
          "type": "array",
          "items": {"type": "string", "pattern": "^3\\.(10|12|13)$"}
        },
        "windows_runner": {"type": "boolean"}
      }
    },
    "compute_contract_evidence_source": {
      "enum": ["generated-file", "generated-in-memory", "unavailable"]
    },
    "artifacts": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "type": ["string", "null"],
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "errors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "non_claims": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
