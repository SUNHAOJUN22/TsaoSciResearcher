{
  "schema_version": "tsao.workflow/1",
  "id": "poe-reference-demo",
  "tasks": [
    {
      "id": "research",
      "capability": "research.route",
      "depends_on": [],
      "payload": {
        "question": "Plan a first-order polymerization kinetics parameter identification study"
      }
    },
    {
      "id": "computation",
      "capability": "computation.route",
      "depends_on": [
        "research"
      ],
      "payload": {
        "question": "polymerization kinetics parameter estimation"
      }
    },
    {
      "id": "curve",
      "capability": "processing.first_order",
      "depends_on": [
        "computation"
      ],
      "payload": {
        "times": [
          0,
          1,
          2,
          5,
          10
        ],
        "time_unit": "s",
        "rate_constant": {
          "value": 0.1,
          "unit": "1/s"
        }
      }
    },
    {
      "id": "fit",
      "capability": "processing.fit_first_order",
      "depends_on": [
        "curve"
      ],
      "payload": {
        "times": {
          "$ref": "curve.times_s"
        },
        "time_unit": "s",
        "conversion": {
          "$ref": "curve.conversion"
        },
        "upper_rate": {
          "value": 1,
          "unit": "1/s"
        }
      }
    },
    {
      "id": "observation",
      "capability": "materials.observation",
      "depends_on": [
        "fit"
      ],
      "payload": {
        "observation": {
          "sample_id": "synthetic-reference",
          "property": "rate_constant",
          "source": "synthetic analytic fixture; not an experimental measurement",
          "conditions": {
            "model": "first-order"
          },
          "evidence_kind": "reference",
          "quantity": {
            "value": {
              "$ref": "fit.rate_constant_s"
            },
            "unit": "1/s"
          }
        }
      }
    }
  ]
}
