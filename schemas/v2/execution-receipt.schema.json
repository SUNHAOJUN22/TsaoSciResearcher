{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tsao-sci-researcher/schemas/v2/execution-receipt.schema.json",
  "title": "TsaoSciResearcher execution receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "project_id",
    "handoff_id",
    "handoff_path",
    "engine",
    "command",
    "started_at",
    "finished_at",
    "duration_seconds",
    "exit_code",
    "status",
    "evidence_level",
    "outputs",
    "environment",
    "notes",
    "recorded_at",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^COMP-"
    },
    "handoff_path": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "exit_code": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "evidence_level": {
      "enum": [
        "executed",
        "failed"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "truth_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "evidence_level": {
            "const": "executed"
          },
          "outputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_level": {
            "const": "failed"
          }
        }
      }
    }
  ]
}
