{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resindb.sunhj.example/schemas/resin-product.schema.json",
  "title": "ResinDB product record",
  "description": "Canonical product/grade record used by the governed resin catalog.",
  "type": "object",
  "required": [
    "id",
    "gradeName",
    "manufacturerId",
    "manufacturer",
    "categoryIds",
    "createdAt",
    "updatedAt",
    "properties"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "gradeName": { "type": "string", "minLength": 1 },
    "manufacturerId": { "type": "string", "minLength": 1 },
    "manufacturer": { "type": "string", "minLength": 1 },
    "categoryIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" },
    "isExperimental": { "type": "boolean" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "priority": { "type": "number" },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/propertyValue" }
    }
  },
  "$defs": {
    "propertyValue": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": ["string", "number"] },
        "unit": { "type": "string" },
        "standard": { "type": "string" },
        "temperature": { "type": ["string", "number"] },
        "referenceId": { "type": "string" },
        "instrument": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "annotation": { "type": "string" },
        "mean": { "type": "number" },
        "stdDev": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "count": { "type": "integer", "minimum": 0 },
        "temp": { "type": "string" },
        "load": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
