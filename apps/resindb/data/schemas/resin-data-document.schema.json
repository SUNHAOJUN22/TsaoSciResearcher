{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resindb.sunhj.example/schemas/resin-data-document.schema.json",
  "title": "ResinDB versioned data document",
  "description": "Canonical UTF-8 JSON envelope for independently versioned ResinDB data assets.",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "dataKind",
    "sourceType",
    "recordStatus",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "updatedAt": { "type": "string", "format": "date" },
    "dataKind": { "type": "string", "minLength": 1 },
    "sourceType": { "type": "string", "minLength": 1 },
    "recordStatus": {
      "enum": ["demo", "reference", "measured", "imported"]
    },
    "data": {}
  },
  "additionalProperties": false
}
