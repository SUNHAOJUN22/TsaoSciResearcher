{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resindb.sunhj.example/schemas/compute-module-catalog.schema.json",
  "title": "ResinDB compute module catalog",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "modules"],
  "properties": {
    "schemaVersion": { "const": "resindb-compute-catalog-1.0.0" },
    "updatedAt": { "type": "string", "format": "date" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "kind", "worker", "hook", "displaySurface", "chartId",
          "inputContract", "outputContract", "mathematicalContract", "scientificBoundary"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["scientific", "quality", "scenario", "infrastructure"] },
          "worker": { "type": "string", "pattern": "^src/workers/.+Worker\\.ts$" },
          "hook": { "type": ["string", "null"] },
          "displaySurface": { "type": "string", "minLength": 1 },
          "chartId": { "type": ["string", "null"] },
          "inputContract": { "type": "string", "minLength": 1 },
          "outputContract": { "type": "string", "minLength": 1 },
          "mathematicalContract": { "type": "string", "minLength": 1 },
          "scientificBoundary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
