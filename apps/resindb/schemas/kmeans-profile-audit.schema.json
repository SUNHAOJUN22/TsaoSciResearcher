{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resindb.local/schemas/kmeans-profile-audit.schema.json",
  "title": "ResinDB K-Means Device Profile Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "scope",
    "notice",
    "importPolicy",
    "profileLoad",
    "profile",
    "environment",
    "workload",
    "autoDecision",
    "decisionHistory",
    "migration",
    "migrationHistory",
    "excludedFields",
    "digestAlgorithm",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "kmeans-profile-audit-1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": { "const": "device-local-non-product-metadata" },
    "notice": { "const": "not-a-cross-device-performance-conclusion" },
    "importPolicy": { "const": "audit-import-never-activates-runtime-profile" },
    "profileLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "savedAt"],
      "properties": {
        "status": { "enum": ["valid", "missing", "invalid", "unavailable", "error"] },
        "reason": { "type": ["string", "null"] },
        "savedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "profile": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "policyVersion",
            "kernel",
            "kernelVersion",
            "protocolVersion",
            "source",
            "eligibleForRuntimeAutoSelection",
            "status",
            "generatedAt",
            "expiresAt",
            "crossoverWorkloadOperations",
            "minimumImprovementRatio",
            "maximumRelativeIqr",
            "requiredConsecutiveWins",
            "benchmarkReportDigest"
          ],
          "properties": {
            "schemaVersion": { "type": "string" },
            "policyVersion": { "type": "string" },
            "kernel": { "type": "string" },
            "kernelVersion": { "type": "string" },
            "protocolVersion": { "type": "string" },
            "source": { "type": "string" },
            "eligibleForRuntimeAutoSelection": { "type": "boolean" },
            "status": { "enum": ["wasm-beneficial", "typescript-preferred", "insufficient-evidence"] },
            "generatedAt": { "type": "string", "format": "date-time" },
            "expiresAt": { "type": "string", "format": "date-time" },
            "crossoverWorkloadOperations": { "type": ["integer", "null"], "minimum": 1 },
            "minimumImprovementRatio": { "type": "number", "minimum": 0 },
            "maximumRelativeIqr": { "type": "number", "minimum": 0 },
            "requiredConsecutiveWins": { "type": "integer", "minimum": 1 },
            "benchmarkReportDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "environment": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "wasm", "wasmSimd", "wasmThreads", "fingerprint"],
          "properties": {
            "runtime": { "enum": ["node", "browser-window", "browser-worker", "unknown"] },
            "wasm": { "type": "boolean" },
            "wasmSimd": { "type": "boolean" },
            "wasmThreads": { "type": "boolean" },
            "fingerprint": { "type": "string" }
          }
        }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "dimensions", "maxClusters"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 0 },
        "dimensions": { "type": "integer", "minimum": 0 },
        "maxClusters": { "type": "integer", "minimum": 0 }
      }
    },
    "autoDecision": { "type": ["object", "null"] },
    "decisionHistory": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "timestamp",
          "requestedBackend",
          "selectedBackend",
          "actualBackend",
          "reason",
          "profileAccepted",
          "profileRejectionReason",
          "fallbackUsed",
          "fallbackReason",
          "workloadOperations",
          "environmentFingerprint"
        ],
        "properties": {
          "schemaVersion": { "const": "kmeans-decision-history-1.0.0" },
          "timestamp": { "type": "string", "format": "date-time" },
          "requestedBackend": { "enum": ["auto", "typescript", "wasm"] },
          "selectedBackend": { "enum": ["typescript", "wasm"] },
          "actualBackend": { "enum": ["typescript", "wasm"] },
          "reason": { "type": "string" },
          "profileAccepted": { "type": "boolean" },
          "profileRejectionReason": { "type": ["string", "null"] },
          "fallbackUsed": { "type": "boolean" },
          "fallbackReason": { "type": ["string", "null"] },
          "workloadOperations": { "type": "integer", "minimum": 0 },
          "environmentFingerprint": { "type": "string" }
        }
      }
    },
    "migration": { "type": ["object", "null"] },
    "migrationHistory": { "type": "array", "items": { "type": "object" } },
    "excludedFields": {
      "const": [
        "product-data",
        "clustering-inputs",
        "raw-benchmark-samples",
        "user-identity",
        "network-addresses"
      ]
    },
    "digestAlgorithm": { "const": "sha-256" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
