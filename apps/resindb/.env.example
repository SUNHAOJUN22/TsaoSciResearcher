# ResinDB Pro local environment
#
# AI is optional. The application does not bundle or select an AI provider.
# Users may configure the same values from Dashboard > AI API Settings.
# Every VITE_* value is exposed to the browser bundle, so use only a restricted
# development key. Production deployments should call an authenticated server-side
# gateway instead of placing a privileged key in the frontend.

# Full OpenAI-compatible chat-completions endpoint.
VITE_AI_API_ENDPOINT=

# Model identifier required by the selected provider. No default is imposed.
VITE_AI_MODEL=

# Optional bearer token for local development only.
VITE_AI_API_KEY=

# Optional deployment base path. Keep leading and trailing slashes, for example:
# /resindb/. Runtime data URLs are derived from this value.
VITE_BASE_PATH=/

# Storage adapter: indexeddb (default) or remote_api.
VITE_DATABASE_ADAPTER_TYPE=indexeddb

# Used only when VITE_DATABASE_ADAPTER_TYPE=remote_api.
VITE_REMOTE_API_BASE_URL=/api

# Optional read/export fallback. Mutating remote operations never fall back to
# IndexedDB because that would create divergent server and browser databases.
VITE_REMOTE_READ_FALLBACK=false
