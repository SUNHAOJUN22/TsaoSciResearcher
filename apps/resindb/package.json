{
  "name": "resindb-pro-by-sunhj",
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run verify:external-data && npm run metrics:build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-test.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-artifacts.mjs && vitest run --pool=forks --maxWorkers=1 --reporter=default --reporter=json --outputFile=artifacts/test-results.json",
    "test:watch": "vitest",
    "test:unit": "node scripts/run-test-files.mjs tests/unit",
    "test:science": "node scripts/run-test-files.mjs tests/science",
    "test:coverage": "node scripts/prepare-artifacts.mjs && vitest run --coverage --pool=forks --maxWorkers=1 && npm run metrics:coverage",
    "benchmark:kmeans:smoke": "node scripts/run-kmeans-backend-benchmark.mjs --mode smoke",
    "benchmark:kmeans": "node scripts/run-kmeans-backend-benchmark.mjs --mode full",
    "validate": "npm run validate:ai-egress && npm run validate:docs && npm run validate:unicode && npm run validate:source && npm run validate:scientific-ui && npm run validate:compute && npm run validate:data && npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke",
    "test:ui": "node scripts/run-ui-smoke-suite.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate:ci": "npm run validate && npm run benchmark:kmeans:smoke && npm run test:unit && npm run test:science && npm run test:coverage && npm run test:ui && npm run audit:all",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:unicode": "node scripts/validate-repository-unicode.mjs --audit",
    "verify:external-data": "node scripts/verify-external-data.mjs",
    "data:manifest": "node scripts/generate-data-manifest.mjs",
    "metrics:build": "node scripts/build-metrics.mjs",
    "metrics:coverage": "node scripts/coverage-metrics.mjs",
    "report:validation": "node scripts/generate-validation-dashboard.mjs",
    "validate:docs": "node scripts/validate-repository-docs.mjs && node scripts/validate-i18n-visuals.mjs",
    "validate:i18n-visuals": "node scripts/validate-i18n-visuals.mjs",
    "validate:source": "node scripts/validate-source-hygiene.mjs",
    "audit:all": "npm audit --audit-level=high",
    "report:pdf": "node scripts/generate-validation-pdf.mjs",
    "report:receipt": "npm run validate:compute && node scripts/generate-validation-receipt.mjs",
    "validate:scientific-ui": "node scripts/validate-scientific-ui.mjs",
    "validate:compute": "node scripts/validate-compute-surface.mjs",
    "validate:ai-egress": "node scripts/validate-ai-egress-governance.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "diff": "^9.0.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.38.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/diff": "^7.0.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.65.0",
    "vite": "^7.2.2",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "dompurify": "3.4.13",
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
