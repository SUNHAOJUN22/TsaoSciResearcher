{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDeepMind First Principles Model Contract",
  "type": "object",
  "required": [
    "model_id",
    "model_class",
    "purpose",
    "states",
    "parameters",
    "relations_or_equations",
    "constraints",
    "boundary",
    "observation_model",
    "error_model",
    "validity_domain"
  ],
  "properties": {
    "model_id": {"type": "string", "minLength": 1},
    "model_class": {
      "enum": ["constraint", "causal", "dynamic", "conservation", "optimization", "bayesian", "argument", "hybrid"]
    },
    "purpose": {"type": "string", "minLength": 1},
    "states": {"type": "array", "items": {"type": "string"}},
    "controls": {"type": "array", "items": {"type": "string"}},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value_or_range": {},
          "unit": {"type": "string"},
          "source": {"type": "string", "minLength": 1},
          "uncertainty": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "relations_or_equations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "initial_conditions": {"type": "array", "items": {"type": "string"}},
    "boundary_conditions": {"type": "array", "items": {"type": "string"}},
    "boundary": {
      "type": "object",
      "required": ["system", "scale", "time"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "scale": {"type": "string", "minLength": 1},
        "time": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "observation_model": {"type": "string", "minLength": 1},
    "error_model": {"type": "string", "minLength": 1},
    "assumptions_and_closures": {"type": "array", "items": {"type": "string"}},
    "validity_domain": {"type": "string", "minLength": 1},
    "numerical_checks": {"type": "array", "items": {"type": "string"}},
    "falsifiers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
