{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDeepMind Aggregated Benchmark",
  "type": "object",
  "required": [
    "benchmark_version",
    "generated_from",
    "expected_runs",
    "complete_runs",
    "configurations",
    "comparisons",
    "incomplete_run_directories",
    "metadata_errors",
    "artifact_set_complete",
    "publication_status",
    "publication_blockers",
    "publication_ready"
  ],
  "properties": {
    "benchmark_version": {"type": "string"},
    "generated_from": {"type": "string"},
    "manifest_split": {"type": ["string", "null"]},
    "expected_runs": {"type": "integer", "minimum": 0},
    "complete_runs": {"type": "integer", "minimum": 0},
    "configurations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "runs": {"type": "integer", "minimum": 0},
          "case_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "assertion_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "red_blocker_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "routing_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "triz_false_activation_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "module_leakage_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "judge_score_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "rival_model_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "falsifier_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "mean_tokens": {"type": ["number", "null"], "minimum": 0},
          "mean_duration_ms": {"type": ["number", "null"], "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "comparisons": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["left", "right", "paired_runs"],
        "properties": {
          "left": {"type": "string"},
          "right": {"type": "string"},
          "scope": {"type": ["string", "null"]},
          "paired_runs": {"type": "integer", "minimum": 0},
          "left_case_pass_wins": {"type": "integer", "minimum": 0},
          "right_case_pass_wins": {"type": "integer", "minimum": 0},
          "case_pass_ties": {"type": "integer", "minimum": 0},
          "mean_assertion_pass_rate_delta_left_minus_right": {"type": ["number", "null"]},
          "mean_judge_score_delta_left_minus_right": {"type": ["number", "null"]},
          "mean_tokens_delta_left_minus_right": {"type": ["number", "null"]},
          "mean_duration_ms_delta_left_minus_right": {"type": ["number", "null"]},
          "blind_pairwise_result": {"type": ["object", "null"]}
        },
        "additionalProperties": true
      }
    },
    "incomplete_run_directories": {"type": "array", "items": {"type": "string"}},
    "metadata_errors": {"type": "array", "items": {"type": "string"}},
    "artifact_set_complete": {"type": "boolean"},
    "publication_status": {
      "enum": [
        "INCOMPLETE_ARTIFACT_SET",
        "EVIDENCE_COMPLETE_AWAITING_INDEPENDENT_ATTESTATION"
      ]
    },
    "publication_blockers": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "publication_ready": {"const": false}
  },
  "additionalProperties": false
}
