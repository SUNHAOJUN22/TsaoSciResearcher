{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SUNHAOJUN22/OpenDeepMind_skill/open-deep-mind/assets/claim-ledger.schema.json",
  "title": "OpenDeepMind Claim Ledger",
  "type": "object",
  "required": [
    "analysis_id",
    "question",
    "domain",
    "scale",
    "purpose",
    "claims"
  ],
  "properties": {
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "scale": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "claim",
          "status",
          "scope",
          "falsifier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          },
          "type": {
            "enum": [
              "D",
              "O",
              "L",
              "C",
              "A",
              "E",
              "V",
              "U"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "supported",
              "plausible",
              "contested",
              "unknown"
            ]
          },
          "scope": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "falsifier": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "review_date": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "premises",
          "rule",
          "conclusion"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "premises": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule": {
            "enum": [
              "deduction",
              "induction",
              "abduction",
              "analogy",
              "simulation",
              "optimization",
              "normative"
            ]
          },
          "conclusion": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "defeaters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "recommendation": {
          "type": "string"
        },
        "foundation_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": "string"
        },
        "review_trigger": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
